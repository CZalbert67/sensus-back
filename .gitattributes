# Force CRLF line endings on checkout for all text files (all platforms)
* text eol=crlf

# Explicit declarations for files that dotnet format / CI inspect
*.cs text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.sln text eol=crlf
*.json text eol=crlf
*.yml text eol=crlf
*.yaml text eol=crlf
*.md text eol=crlf
*.editorconfig text eol=crlf

# Binary files — do not touch line endings
*.dll binary
*.pdb binary
*.exe binary
*.zip binary
*.nupkg binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
